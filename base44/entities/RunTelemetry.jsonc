{
  "name": "RunTelemetry",
  "type": "object",
  "properties": {
    "run_type": {
      "type": "string",
      "default": "validation"
    },
    "subsystem": {
      "type": "string",
      "default": "system"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "degraded",
        "failed",
        "skipped_unauthorized"
      ],
      "default": "ok"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_ms": {
      "type": "number"
    },
    "records_written": {
      "type": "number"
    },
    "message": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "run_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
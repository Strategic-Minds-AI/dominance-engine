{
  "name": "BusinessCard",
  "type": "object",
  "properties": {
    "launched_site_id": {
      "type": "string",
      "description": "LaunchedSite this card belongs to"
    },
    "name": {
      "type": "string",
      "description": "Full name"
    },
    "title": {
      "type": "string",
      "description": "Professional title"
    },
    "company": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "address": {
      "type": "string"
    },
    "social_links": {
      "type": "string",
      "description": "JSON: {facebook, instagram, linkedin, twitter, tiktok}"
    }
  },
  "required": [
    "launched_site_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
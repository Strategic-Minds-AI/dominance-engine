{
  "name": "Brochure",
  "type": "object",
  "properties": {
    "launched_site_id": {
      "type": "string",
      "description": "LaunchedSite this brochure belongs to"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "content_markdown": {
      "type": "string",
      "format": "richtext",
      "description": "Brochure body content"
    },
    "services": {
      "type": "string",
      "description": "Comma-separated service names"
    },
    "image_urls": {
      "type": "string",
      "description": "JSON array of image URLs"
    },
    "contact_phone": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "cta_text": {
      "type": "string",
      "description": "Call-to-action text"
    }
  },
  "required": [
    "launched_site_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PostSchedule",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "title": "Content Category"
    },
    "platform": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "twitter",
        "linkedin",
        "tiktok",
        "youtube",
        "all"
      ],
      "default": "all"
    },
    "day_of_week": {
      "type": "string",
      "enum": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday",
        "everyday"
      ],
      "default": "everyday"
    },
    "time_of_day": {
      "type": "string",
      "title": "Time of Day (HH:MM 24h)"
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "category",
    "platform",
    "day_of_week",
    "time_of_day"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
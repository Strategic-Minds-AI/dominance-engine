{
  "name": "CompetitorDigitalTwin",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "competitor_name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "resistance_score": {
      "type": "number"
    },
    "weakness": {
      "type": "string"
    },
    "displacement_score": {
      "type": "number"
    },
    "measured_provenance": {
      "type": "string",
      "enum": [
        "MEASURED",
        "PROVIDER",
        "INFERRED"
      ],
      "default": "INFERRED"
    },
    "inferred_provenance": {
      "type": "string",
      "enum": [
        "INFERRED",
        "MODELED"
      ],
      "default": "INFERRED"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "competitor_name"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
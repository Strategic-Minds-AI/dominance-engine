{
  "name": "AgentJob",
  "type": "object",
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "blocked_awaiting_approval",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "requires_approval": {
      "type": "boolean",
      "default": true
    },
    "payload": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "queued_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "kind"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
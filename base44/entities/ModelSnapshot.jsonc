{
  "name": "ModelSnapshot",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "cycle_id": {
      "type": "string"
    },
    "config": {
      "type": "string"
    },
    "score_at_snapshot": {
      "type": "number",
      "default": 0
    },
    "is_last_known_good": {
      "type": "boolean",
      "default": false
    },
    "restored_count": {
      "type": "number",
      "default": 0
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
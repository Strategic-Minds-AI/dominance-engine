{
  "name": "TemplatePack",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Pack name"
    },
    "kind": {
      "type": "string",
      "enum": [
        "web_pack",
        "logo_pack",
        "brand_pack",
        "mockup"
      ],
      "description": "What kind of pack this is"
    },
    "description": {
      "type": "string",
      "description": "Short description of the pack"
    },
    "preview_html": {
      "type": "string",
      "description": "Full renderable HTML (mockup) shown in the visual preview and served live"
    },
    "manifest": {
      "type": "string",
      "description": "JSON string: assets (image/font URLs), sections, meta"
    },
    "brand_tokens": {
      "type": "string",
      "description": "JSON string: colors, fonts, logo_url"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_review",
      "description": "Approval status"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "gpt_sync"
      ],
      "default": "manual",
      "description": "How the pack entered the system"
    },
    "submitted_by_label": {
      "type": "string",
      "description": "Who submitted it (label)"
    },
    "version": {
      "type": "string",
      "default": "1.0.0"
    }
  },
  "required": [
    "name",
    "kind",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
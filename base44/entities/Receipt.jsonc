{
  "name": "Receipt",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "default": "measurement"
    },
    "summary": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "MEASURED",
        "PROVIDER",
        "INFERRED",
        "MODELED",
        "UNKNOWN"
      ],
      "default": "MEASURED"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "hash": {
      "type": "string"
    },
    "proof_level": {
      "type": "number"
    },
    "type": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "details": {
      "type": "string"
    }
  },
  "required": [
    "summary"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
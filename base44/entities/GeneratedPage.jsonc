{
  "name": "GeneratedPage",
  "type": "object",
  "properties": {
    "website_id": {
      "type": "string",
      "description": "Parent Website id (legacy factory)"
    },
    "website_name": {
      "type": "string"
    },
    "launched_site_id": {
      "type": "string",
      "description": "LaunchedSite this page belongs to (programmatic launcher)"
    },
    "slug": {
      "type": "string",
      "description": "Unique URL slug"
    },
    "route_path": {
      "type": "string",
      "description": "Full path /slug"
    },
    "keyword": {
      "type": "string",
      "description": "Target search keyword"
    },
    "page_type": {
      "type": "string",
      "enum": [
        "home",
        "service",
        "location",
        "guide",
        "faq",
        "contact",
        "about"
      ],
      "default": "service"
    },
    "title": {
      "type": "string",
      "description": "SEO title tag"
    },
    "h1": {
      "type": "string"
    },
    "meta_description": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "practice_area": {
      "type": "string",
      "description": "Service / practice area name"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "state_code": {
      "type": "string"
    },
    "county": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "content_markdown": {
      "type": "string",
      "format": "richtext",
      "description": "Full page content (programmatic launcher)"
    },
    "faq": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of {q/question, a/answer} objects"
    },
    "schema_json": {
      "type": "object",
      "description": "JSON-LD schema object (or { @graph: [...] })"
    },
    "intent": {
      "type": "string"
    },
    "canonical_url": {
      "type": "string"
    },
    "canonical_path": {
      "type": "string"
    },
    "compliance_flags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "differentiation_layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "validated",
        "published",
        "excluded"
      ],
      "default": "draft"
    }
  },
  "required": [
    "slug",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
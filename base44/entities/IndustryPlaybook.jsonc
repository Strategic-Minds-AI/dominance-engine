{
  "name": "IndustryPlaybook",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "sub_industry": {
      "type": "string"
    },
    "benchmark_summary": {
      "type": "string"
    },
    "target_summary": {
      "type": "string"
    },
    "competitor_strengths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "competitor_failure_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface_wins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "norms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partner_authority_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "partner_p_cross_boost": {
      "type": "number",
      "default": 0
    },
    "provenance": {
      "type": "string",
      "enum": [
        "MEASURED",
        "PROVIDER",
        "INFERRED",
        "MODELED"
      ],
      "default": "MODELED"
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "industry"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "PromptLibrary",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "audit",
        "implement",
        "automate",
        "autonomy",
        "validate",
        "monitor",
        "demonstrate",
        "fast_rank",
        "research",
        "ecosystem"
      ],
      "default": "implement"
    },
    "title": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "intent": {
      "type": "string"
    },
    "invoke_function": {
      "type": "string"
    },
    "impact": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ],
      "default": "high"
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "run",
        "pending"
      ],
      "default": "ready"
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "category",
    "title",
    "prompt"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
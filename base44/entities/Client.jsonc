{
  "type": "object",
  "name": "Client",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client or brand name"
    },
    "brand_name": {
      "type": "string",
      "description": "Display brand name shown on launched sites"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "domain": {
      "type": "string",
      "description": "Primary custom domain for this client's sites"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
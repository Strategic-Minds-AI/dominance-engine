{
  "name": "EdenSession",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Opaque public session identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "abandoned"
      ],
      "default": "active"
    },
    "step": {
      "type": "integer",
      "default": 0
    },
    "first_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "business_stage": {
      "type": "string"
    },
    "business": {
      "type": "string"
    },
    "vision": {
      "type": "string"
    },
    "colors": {
      "type": "string"
    },
    "special_requests": {
      "type": "string"
    },
    "selected_direction": {
      "type": "integer"
    },
    "transcript": {
      "type": "string",
      "description": "JSON conversation transcript"
    },
    "last_reply": {
      "type": "string"
    },
    "source_pack_id": {
      "type": "string"
    },
    "source_version_slug": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
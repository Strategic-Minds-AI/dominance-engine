{
  "name": "GatewayMessage",
  "type": "object",
  "properties": {
    "conversation_id": {
      "type": "string",
      "description": "Parent GatewayConversation id"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "tool"
      ]
    },
    "content": {
      "type": "string",
      "description": "Message text"
    },
    "request_key": {
      "type": "string",
      "description": "Correlation key pairing user + assistant messages"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of tool call receipts"
    },
    "provider": {
      "type": "string",
      "default": "vercel_ai_gateway"
    },
    "model": {
      "type": "string"
    }
  },
  "required": [
    "conversation_id",
    "role",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
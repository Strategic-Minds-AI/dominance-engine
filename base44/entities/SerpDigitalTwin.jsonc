{
  "name": "SerpDigitalTwin",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string"
    },
    "query": {
      "type": "string"
    },
    "snapshot_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_composition": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "churn_score": {
      "type": "number"
    },
    "movement_score": {
      "type": "number"
    },
    "provenance": {
      "type": "string",
      "enum": [
        "MEASURED",
        "PROVIDER",
        "INFERRED",
        "MODELED"
      ],
      "default": "MEASURED"
    },
    "diff_from_previous": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "query"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
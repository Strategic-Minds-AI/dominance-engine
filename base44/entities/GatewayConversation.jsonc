{
  "name": "GatewayConversation",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string",
      "description": "Agent handling this conversation"
    },
    "launched_site_id": {
      "type": "string",
      "description": "LaunchedSite this conversation belongs to"
    },
    "provider": {
      "type": "string",
      "default": "vercel_ai_gateway"
    },
    "model": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "description": "Optional session metadata"
    }
  },
  "required": [
    "agent_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
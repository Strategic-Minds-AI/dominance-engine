{
  "name": "GeneratedAsset",
  "type": "object",
  "properties": {
    "generator_type": {
      "type": "string",
      "enum": [
        "idea",
        "wealth_strategy",
        "content",
        "reverse_engineer",
        "document",
        "programmatic_site",
        "funnel_idea",
        "problem_solution",
        "elite_scan",
        "ai_company_data"
      ]
    },
    "title": {
      "type": "string"
    },
    "input_prompt": {
      "type": "string"
    },
    "output_json": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform": {
      "type": "string"
    },
    "compliance_score": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "generated",
        "reviewed",
        "approved",
        "deployed",
        "archived"
      ],
      "default": "generated"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "generator_type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
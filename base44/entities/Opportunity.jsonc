{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "service": {
      "type": "string"
    },
    "service_slug": {
      "type": "string"
    },
    "vertical": {
      "type": "string"
    },
    "metro": {
      "type": "string"
    },
    "intent": {
      "type": "string",
      "enum": [
        "transactional",
        "emergency",
        "comparison",
        "cost",
        "availability",
        "informational"
      ],
      "default": "transactional"
    },
    "pattern": {
      "type": "string",
      "enum": [
        "near_me",
        "near_you",
        "branded_hub"
      ],
      "default": "near_me"
    },
    "lead_value": {
      "type": "number"
    },
    "urgency": {
      "type": "number"
    },
    "buyer_density": {
      "type": "number"
    },
    "est_monthly_search": {
      "type": "number"
    },
    "opportunity_score": {
      "type": "number"
    },
    "monetization_hypothesis": {
      "type": "string"
    },
    "buyer_archetype": {
      "type": "string"
    },
    "recommended_url": {
      "type": "string"
    },
    "domain_candidate": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "scored",
        "validated",
        "building",
        "launched",
        "killed"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "service",
    "intent",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
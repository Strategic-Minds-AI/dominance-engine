{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_analytics_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_analytics": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAnalytics",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync GSC + GA data",
            "description": "Pull performance data for all live sites"
          }
        }
      }
    ]
  },
  "description": "Pulls daily Google Search Console and Google Analytics performance data for all live launched sites into SiteMetric snapshots.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Daily Analytics Sync"
}
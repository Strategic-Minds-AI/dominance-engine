{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/strategic-minds",
      "destination": "/strategic-minds/index.html"
    },
    {
      "source": "/strategic-minds/solutions/:slug",
      "destination": "/strategic-minds/solutions/:slug/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
